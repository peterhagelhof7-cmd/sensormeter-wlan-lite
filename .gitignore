.pio/
.vscode/
**/include/config.h
*.bin
# Ausnahme: fertig gebaute Release-Artefakte zum manuellen OTA-Upload,
# bewusst versioniert (Namensformat <FIRMWARE_PROJECT_ID>-<Version>.bin).
!firmware/releases/*.bin
firmware/logs/
firmware/data/

# Generierte PDF-Doku wird nicht mehr versioniert (nur die HTML-/MD-Quellen);
# bei Bedarf lokal aus dem HTML drucken.
docs/*.pdf
